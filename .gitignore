node_modules
out
dist
*.log
.DS_Store
.vite
release
*.spbackup
.npmrc
*.tsbuildinfo

# Tunnel engines are built from source by scripts/build-{sidecar,frpc,openvpn}.sh
# and fetched by scripts/fetch-wintun.sh. The manifest is committed so a clone
# knows which hashes it expects; the binaries themselves are build output.
resources/bin/*
!resources/bin/manifest.json
.frp-build/
.openvpn-build/
.wintun-build/

# The GPL-2.0 §3 corresponding source for the OpenVPN we ship. Produced by
# scripts/build-openvpn.sh and attached to the GitHub release; it is a copy of
# upstream, so there is nothing to gain from committing it here.
.openvpn-src/

# Scratch root for tests that need a directory no other user can write to
# (os.tmpdir() is /tmp on Linux, which the binary resolver correctly refuses).
.tmp-tests/

# Stray local build of the Go sidecar. The shipped binaries go to
# resources/bin/ via scripts/build-sidecar.sh; this one is nobody's artifact.
sidecar/netd/netd
tests/.tmp-cloudexec/

# A bare `go build` in the sidecar leaves its binary beside the source.
# The real output goes to resources/bin via scripts/build-addyd.sh.
sidecar/addyd/addyd
sidecar/netd/netd

# A local `go` wrapper that skips `vet` and `test`, for machines where the
# module proxy stalls during test-dependency resolution. It exists to get the
# engines built, not to be shared: the gate it removes is a real one, so it
# must not travel to a machine where it would quietly apply. Ignored rather
# than deleted so the machine that needed it keeps it.
.go-shim/
